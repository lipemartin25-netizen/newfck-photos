{
  "name": "AlbumAI - Watch Local Folder & Split Scans",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "path": "/app/uploads/watch",
        "options": {}
      },
      "name": "Local Folder Trigger",
      "type": "n8n-nodes-base.localFileTrigger",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/upload",
        "sendBinaryData": true,
        "binaryPropertyName": "data",
        "options": {}
      },
      "name": "Upload to AlbumAI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [300, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/detect",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "image_id",
              "value": "={{ $json.id }}"
            }
          ]
        },
        "options": {}
      },
      "name": "DINO Detect",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [500, 300]
    }
  ],
  "connections": {
    "Local Folder Trigger": {
      "main": [
        [
          {
            "node": "Upload to AlbumAI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload to AlbumAI": {
      "main": [
        [
          {
            "node": "DINO Detect",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}
